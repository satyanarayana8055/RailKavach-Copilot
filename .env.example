# Environment Configuration Template — RailKavach Copilot

# ========================================================
# Google AI / Gemini API Credentials
# Get your API key at: https://aistudio.google.com/app/api-keys
# ========================================================
GEMINI_API_KEY=

# Model Selection (gemini-1.5-flash for cost & speed, gemini-1.5-pro for heavy reports)
DEFAULT_MODEL=gemini-1.5-flash
PRO_MODEL=gemini-1.5-pro

# ========================================================
# Langfuse Observability (LLM tracing)
# Keys: Langfuse → Project Settings → API Keys. Required for Cloud Run deploys.
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com  or your self-hosted URL
# ========================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set true to refuse startup without keys (deploy script sets this automatically)
LANGFUSE_REQUIRED=false
APP_ENV=development

# ========================================================
# Operational & Token Settings
# ========================================================
DEFAULT_MODEL=gemini-3.5-flash-lite
PRO_MODEL=gemini-3.8-flash
LOCAL_MODEL_PROVIDER=gemma
LOCAL_GEMMA_URL=http://localhost:11434/api/generate
LOCAL_GEMMA_MODEL=gemma2:9b
PREFER_LOCAL_MODEL=false
ENABLE_CACHE_FALLBACK=true
MAX_OUTPUT_TOKENS=1024
MAX_REPORT_TOKENS=2048
WINDOW_MINUTES_BEFORE=15
WINDOW_MINUTES_AFTER=5

# Backend Port & Host
HOST=0.0.0.0
PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
